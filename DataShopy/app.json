{
  "expo": {
    "name": "DataShopy",
    "slug": "DataShopy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0E0C"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para mostrar locales cercanos.",
        "NSPhotoLibraryUsageDescription": "DataShopy necesita acceso a tus fotos para subir el logo, la portada y la galería del negocio.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0E0C"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.govanni.DataShopy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "DataShopy necesita acceso a tus fotos para subir el logo, la portada y la galería del negocio."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://vwmdgxwxqedhhsqgxhoe.supabase.co",
      "supabaseAnonKey": "sb_publishable_kTg7RHdR0-vOkNxAQb4fdA_zykt4ySY"
    }
  }
}
